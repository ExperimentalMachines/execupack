+++ b/examples/mediatek/model_export_scripts/llama.py
@@ -59,6 +59,39 @@ from tqdm import tqdm
 warnings.filterwarnings("ignore")
 
 
+def _retry_compile_service_start():
+    """exe-expo: MediaTek's compiler client starts a local service on a random port per
+    compile and polls it over HTTP; starting it fails now and then, after hours of work (the
+    same retry lfm2.py carries, mediatek-lfm2.patch). The compile is a pure function of its
+    input, so it is asked again; any error that is not about the service, or a third
+    failure, still stops the export."""
+    import time as _time
+
+    try:
+        import mtk_neuron
+    except ImportError:
+        return
+    compile_once = getattr(mtk_neuron, "compile", None)
+    if compile_once is None or getattr(compile_once, "retries_service_start", False):
+        return
+
+    def compile_with_retry(*args, **kwargs):
+        for attempt in range(3):
+            try:
+                return compile_once(*args, **kwargs)
+            except RuntimeError as error:
+                if "service" not in str(error) or attempt == 2:
+                    raise
+                print(f"mtk_neuron: {error}; asking again ({attempt + 2} of 3)", flush=True)
+                _time.sleep(10)
+
+    compile_with_retry.retries_service_start = True
+    mtk_neuron.compile = compile_with_retry
+
+
+_retry_compile_service_start()
+
+
