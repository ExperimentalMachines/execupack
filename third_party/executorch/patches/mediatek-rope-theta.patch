diff --git a/examples/mediatek/aot_utils/llm_utils/utils.py b/examples/mediatek/aot_utils/llm_utils/utils.py
index 9d5fa24..eefa6bf 100644
--- a/examples/mediatek/aot_utils/llm_utils/utils.py
+++ b/examples/mediatek/aot_utils/llm_utils/utils.py
@@ -735,6 +735,21 @@ def get_master_rot_emb(config, dtype, **kwargs):
         inv_freq = 1.0 / (
             base ** (np.arange(0, rot_dim, 2, dtype=np.float32) / rot_dim)
         )  # (rot_dim/2)
+        llama3 = getattr(config, "llama3_rope", None)
+        if llama3:
+            # transformers modeling_rope_utils._compute_llama3_parameters
+            factor = float(llama3["factor"])
+            low_freq_factor = float(llama3.get("low_freq_factor", 1.0))
+            high_freq_factor = float(llama3.get("high_freq_factor", 4.0))
+            old_context_len = float(llama3["original_max_position_embeddings"])
+            low_freq_wavelen = old_context_len / low_freq_factor
+            high_freq_wavelen = old_context_len / high_freq_factor
+            wavelen = 2 * math.pi / inv_freq
+            scaled = np.where(wavelen > low_freq_wavelen, inv_freq / factor, inv_freq)
+            smooth = (old_context_len / wavelen - low_freq_factor) / (high_freq_factor - low_freq_factor)
+            smoothed = (1 - smooth) * scaled / factor + smooth * scaled
+            medium = ~(wavelen < high_freq_wavelen) & ~(wavelen > low_freq_wavelen)
+            inv_freq = np.where(medium, smoothed, scaled).astype(np.float32)
         t = np.arange(length, dtype=np.float32)  # (len)
         freqs = np.einsum("i,j->ij", t, inv_freq)  # (len, rot_dim/2)
         emb = np.concatenate((freqs, freqs), axis=-1)  # (len, rot_dim)
diff --git a/examples/mediatek/models/llm_models/configuration_llama.py b/examples/mediatek/models/llm_models/configuration_llama.py
index e9194fc..6ac967f 100644
--- a/examples/mediatek/models/llm_models/configuration_llama.py
+++ b/examples/mediatek/models/llm_models/configuration_llama.py
@@ -78,6 +78,13 @@ class LlamaConfig(BaseConfig):
             raise ValueError("Positional embedding must be one of: rope, alibi")
         self.position_embedding = position_embedding
         self.ntk_scaling_factor = kwargs.pop("ntk_scaling_factor", 1.0)
+        # get_master_rot_emb reads rope_theta (execupack mediatek-lfm2.patch); without it the
+        # table is built at 10000, which is not what Qwen (1e6) or Llama 3.2 (5e5) was trained on.
+        self.rope_theta = float(kwargs.pop("rope_theta", 10000.0) or 10000.0)
+        # Llama 3.1+ frequency scaling (rope_type "llama3", every Llama 3.2 config). Kept apart
+        # from rope_scaling, whose branches in get_master_rot_emb key on "type".
+        scaling = kwargs.pop("rope_scaling", None) or {}
+        self.llama3_rope = scaling if (scaling.get("rope_type") or scaling.get("type")) == "llama3" else None
         if self.ntk_scaling_factor != 1.0 and self.position_embedding != "rope":
             raise KeyError("ntk_scaling_factor is strictly for position_embedding=rope")
         self.max_position_embeddings = max_position_embeddings
