+def _retry_compile_service_start():
+    """execupack: MediaTek's compiler client starts a local service on a random port per
+    compile and polls it over HTTP; starting it fails now and then, after hours of work (the
+    same retry llama.py and qwen.py carry, mediatek-calibration-as-arrays.patch). The compile
+    is a pure function of its input, so it is asked again; any error that is not about the
+    service, or a third failure, still stops the export."""
+    import time as _time
+
+    try:
+        import mtk_neuron
+    except ImportError:
+        return
+    compile_once = getattr(mtk_neuron, "compile", None)
+    if compile_once is None or getattr(compile_once, "retries_service_start", False):
+        return
+
+    def compile_with_retry(*args, **kwargs):
+        for attempt in range(3):
+            try:
+                return compile_once(*args, **kwargs)
+            except RuntimeError as error:
+                if "service" not in str(error) or attempt == 2:
+                    raise
+                print(f"mtk_neuron: {error}; asking again ({attempt + 2} of 3)", flush=True)
+                _time.sleep(10)
+
+    compile_with_retry.retries_service_start = True
+    mtk_neuron.compile = compile_with_retry
+
+
+_retry_compile_service_start()
+
+
+def local_rot_emb(config):
+    """execupack: Gemma 3's sliding layers' RoPE table, at rope_local_base_freq. get_master_rot_emb
+    builds at config.rope_theta (mediatek-rope-theta.patch), Gemma 3's global base."""
+    import copy
+
+    local = copy.copy(config)
+    local.rope_theta = config.rope_local_base_freq
+    return get_master_rot_emb(local, dtype=torch.float32)
+
