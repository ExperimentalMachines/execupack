# Toolchain versions that are not pip packages, plus the ExecuTorch releases the backends build
# with. EXECUTORCH_VERSION is the CPU and GPU exporter's; tests/test_versions.py checks the pip
# pins agree with it. It may run ahead of the apps' runtime (APP_RUNTIME_VERSION below), whose
# executorch-android AAR (gradle/libs.versions.toml in each app) decides what may be published:
# a newer exporter can emit method names the older runtime does not know. The NPU backends
# build one release behind: see QNN_EXECUTORCH_VERSION and MTK_EXECUTORCH_VERSION.
EXECUTORCH_VERSION=1.6.0
# The oldest ExecuTorch runtime the apps ship (openweights 1.5.1-openweights.4, ExecuServe
# 1.5.1-execuserve.4). Publishing refuses a file built with a newer release than this
# (publish.require_publishable), because ExecuTorch promises an older program loads on a newer
# runtime and nothing the other way. Move it only once both apps ship the newer runtime.
APP_RUNTIME_VERSION=1.5.1
PYTHON_VERSION=3.11
# Qualcomm exports stay on ExecuTorch 1.5.1 and its QAIRT 2.37. ExecuTorch 1.6.0's wheel pins
# and downloads QAIRT 2.51.0.260929 (backends/qualcomm/scripts/qnn_config.sh), and a context
# binary from a newer SDK is not promised to load on an older QNN runtime: both apps ship
# qnn-runtime 2.39.0, which loads 2.37's binaries. A 1.6.0 runtime loads 1.5.1 programs (one
# minor back), so these files stay loadable as the apps move to 1.6.0. Move this pin, and
# QAIRT_VERSION with it, once the apps' QNN runtime is at least the SDK it would compile with.
QNN_EXECUTORCH_VERSION=1.5.1
# QAIRT (Qualcomm AI Runtime SDK) the executorch 1.5.1 wheel is built against and downloads
# when asked (backends/qualcomm/scripts/qnn_config.sh). executorch-android-qnn:1.5.1
# depends on qnn-runtime 2.37.0. Used as the Actions cache key for the SDK.
QAIRT_VERSION=2.37.0.250724
# MediaTek NeuroPilot Express SDK 8.0.8 (neuropilot-express-sdk-8.0.8-build20250925.tar.gz),
# from MediaTek's download table (neuropilot.mediatek.com, NeuroPilot Express SDK page),
# downloaded at run time and checked against this digest. It carries mtk_neuron 8.2.23, the
# version ExecuTorch 1.4.0 and 1.5.1 document (backends/mediatek/README.md): the LLM path calls
# mtk_neuron.extract_shared_data, which 8.2.19 in the build20250327 archive that ExecuTorch's
# CI installs lacks (docs/research, finding 19). Licensed by MediaTek Inc. under its own terms
# (THIRD_PARTY_NOTICES.md); nothing from it is committed, cached or re-published.
# mtk_converter is cp310-only.
NEUROPILOT_SDK_URL=https://s3.ap-southeast-1.amazonaws.com/mediatek.neuropilot.com/b1c485de-fca8-4b20-836a-8b33152a3609.gz
NEUROPILOT_SDK_SHA256=42155c3b25e9f9af1bef55534d0700835f32564a289e8cb1e44f0b2433ddab48
NEUROPILOT_SDK_BUILD=8.0.8-build20250925
MTK_CONVERTER_VERSION=8.13.0
MTK_NEURON_VERSION=8.2.23
MTK_PYTHON_VERSION=3.10
# MediaTek exports stay on ExecuTorch 1.5.1 too: mtk_converter is cp310-only and 1.6.0 publishes
# no cp310 wheel (it requires Python >= 3.11). Nothing the export runs moved in 1.6.0:
# backends/mediatek's Python and examples/mediatek's scripts are unchanged from 1.5.1 (only
# build files differ: two scripts' -j and the runtime's BUCK), so the patches apply to either.
# A 1.6.0 runtime loads 1.5.1 programs (one minor back is ExecuTorch's promise), so files from
# this toolchain stay inside it.
MTK_EXECUTORCH_VERSION=1.5.1
# ExecuTorch source for examples/mediatek (the LLM export scripts are not in the wheel), at
# MTK_EXECUTORCH_VERSION's tag (v1.5.1) so the scripts match the wheel that runs them.
EXECUTORCH_COMMIT=3b60683923245cf472b7323426920e15623ba361
