# Toolchain versions that are not pip packages, plus the ExecuTorch release every backend
# must match. EXECUTORCH_VERSION has to equal the executorch-android AAR the openweights app
# ships (gradle/libs.versions.toml there): a newer exporter can emit method names the older
# runtime does not know. tests/test_versions.py checks the pip pins agree with it.
EXECUTORCH_VERSION=1.5.1
PYTHON_VERSION=3.11
# QAIRT (Qualcomm AI Runtime SDK) the executorch 1.5.1 wheel is built against and downloads
# on first import (backends/qualcomm/scripts/qnn_config.sh). executorch-android-qnn:1.5.1
# depends on qnn-runtime 2.37.0. Used as the Actions cache key for the SDK.
QAIRT_VERSION=2.37.0.250724
# MediaTek NeuroPilot Express SDK 8.0.8 (neuropilot-express-sdk-8.0.8-build20250925.tar.gz),
# from MediaTek's download table (neuropilot.mediatek.com, NeuroPilot Express SDK page),
# downloaded at run time and checked against this digest. It carries mtk_neuron 8.2.23, the
# version ExecuTorch 1.4.0 and 1.5.1 document (backends/mediatek/README.md): the LLM path calls
# mtk_neuron.extract_shared_data, which 8.2.19 in the build20250327 archive that ExecuTorch's
# CI installs lacks (docs/research, finding 19). Licensed by MediaTek Inc. under its own terms
# (THIRD_PARTY_NOTICES.md); nothing from it is committed, cached or re-published.
# mtk_converter is cp310-only.
NEUROPILOT_SDK_URL=https://s3.ap-southeast-1.amazonaws.com/mediatek.neuropilot.com/b1c485de-fca8-4b20-836a-8b33152a3609.gz
NEUROPILOT_SDK_SHA256=42155c3b25e9f9af1bef55534d0700835f32564a289e8cb1e44f0b2433ddab48
NEUROPILOT_SDK_BUILD=8.0.8-build20250925
MTK_CONVERTER_VERSION=8.13.0
MTK_NEURON_VERSION=8.2.23
MTK_PYTHON_VERSION=3.10
# ExecuTorch source for examples/mediatek (the LLM export scripts are not in the wheel).
EXECUTORCH_COMMIT=3b60683923245cf472b7323426920e15623ba361
